# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# Mật khẩu SQL Server: tối thiểu 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
# Tránh dùng ký tự ; ' " $ trong mật khẩu.
MSSQL_SA_PASSWORD=DoiMatKhau@123

# Khóa ký JWT: chuỗi ngẫu nhiên dài tối thiểu 32 ký tự.
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_KEY=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Mật khẩu tài khoản admin (username: admin) tạo tự động lần chạy đầu tiên
ADMIN_PASSWORD=DoiMatKhauAdmin@123
